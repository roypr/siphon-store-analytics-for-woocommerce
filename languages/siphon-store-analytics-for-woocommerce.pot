#. Plugin URI of the plugin
#: siphon-store-analytics-for-woocommerce.php
msgid "https://siphon-tech.com/siphon-store-analytics-for-woocommerce"
msgstr ""

#. Description of the plugin
#: siphon-store-analytics-for-woocommerce.php
msgid "Natural language to SQL query tool for WooCommerce. Converts plain English questions into SQL queries against WooCommerce data using the WordPress AI Client (7.0+), or your own AI provider key (OpenAI, Claude, OpenRouter, DeepSeek, Groq, Mistral, xAI, or any OpenAI-compatible endpoint)."
msgstr ""

#. Author of the plugin
#: siphon-store-analytics-for-woocommerce.php
msgid "Siphon Technologies"
msgstr ""

#. Author URI of the plugin
#: siphon-store-analytics-for-woocommerce.php
msgid "https://github.com/roypr"
msgstr ""

